{
  "providers": {
    "inception": {
      "baseUrl": "https://api.inceptionlabs.ai/v1",
      "api": "openai-completions",
      "apiKey": "$MERCURY_API_KEY",
      "compat": {
        "supportsStore": false,
        "supportsDeveloperRole": false,
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "mercury-2.5",
          "name": "Mercury 2.5",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 260000,
          "maxTokens": 8192,
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "thinkingLevelMap": {
            "off": null,
            "minimal": "instant",
            "low": "instant",
            "medium": "medium",
            "high": "high",
            "xhigh": "high",
            "max": "high"
          }
        }
      ]
    },
    "deepseek": {
      "models": [
        {
          "id": "deepseek-v4-flash-vision-exp",
          "name": "DeepSeek V4 Flash Vision Exp",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cacheRead": 0.0028,
            "cacheWrite": 0
          },
          "contextWindow": 1000000,
          "maxTokens": 384000,
          "compat": {
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "maxTokensField": "max_tokens",
            "requiresReasoningContentOnAssistantMessages": true,
            "thinkingFormat": "deepseek"
          },
          "thinkingLevelMap": {
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "max": "max"
          }
        }
      ]
    }
  }
}
